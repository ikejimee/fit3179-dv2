{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The adventure gender gap",
    "subtitle": "Male vs female participation rate by activity, 2025",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "subtitleColor": "#555"
  },
  "width": "container",
  "height": 340,
  "data": { "url": "data/activity_national.csv" },
  "transform": [
    {
      "filter": {
        "field": "activity",
        "oneOf": [
          "Bush walking",
          "Cycling",
          "Surfing",
          "Fishing (recreational)",
          "Canoeing/Kayaking",
          "Mountain biking",
          "Sport climbing",
          "Rock climbing/Abseiling/Caving",
          "Sailing"
        ]
      }
    }
  ],
  "encoding": {
    "y": {
      "field": "activity",
      "type": "nominal",
      "sort": { "field": "male", "order": "descending" },
      "title": null,
      "axis": { "labelFontSize": 12 }
    }
  },
  "layer": [
    {
      "mark": { "type": "rule", "color": "#bbb", "strokeWidth": 2 },
      "encoding": {
        "x": { "field": "female", "type": "quantitative", "title": "Participation rate (%)" },
        "x2": { "field": "male" }
      }
    },
    {
      "transform": [{ "fold": ["male", "female"], "as": ["sex", "rate_sex"] }],
      "mark": { "type": "point", "filled": true, "size": 130 },
      "encoding": {
        "x": { "field": "rate_sex", "type": "quantitative" },
        "color": {
          "field": "sex",
          "type": "nominal",
          "title": "Sex",
          "scale": {
            "domain": ["male", "female"],
            "range": ["#0072B2", "#E69F00"]
          },
          "legend": { "orient": "top", "labelExpr": "datum.label == 'male' ? 'Male' : 'Female'" }
        },
        "tooltip": [
          { "field": "activity", "type": "nominal", "title": "Activity" },
          { "field": "sex", "type": "nominal", "title": "Sex" },
          { "field": "rate_sex", "type": "quantitative", "title": "Participation (%)", "format": ".2f" }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter, system-ui, sans-serif",
    "view": { "stroke": null },
    "axisX": { "grid": true, "gridColor": "#eee" },
    "axisY": { "grid": false }
  }
}
