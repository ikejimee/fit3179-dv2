{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Participation rate by age group, per activity, 2025",
    "subtitle": "Participation rate (%) by age group, 2025. Note: each panel has its own y-axis, so heights are not comparable between panels."
  },
  "data": { "url": "data/activity_age_national.csv" },
  "columns": 3,
  "facet": {
    "field": "activity",
    "type": "nominal",
    "title": null,
    "header": { "labelFontSize": 12, "labelFontWeight": "bold", "labelColor": "#14543b" },
    "sort": ["Bush walking", "Cycling", "Surfing", "Canoeing/Kayaking", "Mountain biking", "Rock climbing/Abseiling/Caving"]
  },
  "spec": {
    "width": 175,
    "height": 115,
    "layer": [
      {
        "mark": {
          "type": "area",
          "line": { "color": "#2e8b57", "strokeWidth": 2 },
          "color": "#a9d9bd"
        },
        "encoding": {
          "x": {
            "field": "age_group",
            "type": "ordinal",
            "title": "Age group",
            "sort": ["15-17", "18-24", "25-34", "35-44", "45-54", "55-64", "65+"],
            "axis": { "labelAngle": -45, "labelFontSize": 9 }
          },
          "y": { "field": "rate", "type": "quantitative", "title": "Participation (%)" }
        }
      },
      {
        "mark": { "type": "point", "filled": true, "color": "#1b6b4f", "size": 28 },
        "encoding": {
          "x": { "field": "age_group", "type": "ordinal", "sort": ["15-17", "18-24", "25-34", "35-44", "45-54", "55-64", "65+"] },
          "y": { "field": "rate", "type": "quantitative" },
          "tooltip": [
            { "field": "activity", "type": "nominal", "title": "Activity" },
            { "field": "age_group", "type": "nominal", "title": "Age" },
            { "field": "rate", "type": "quantitative", "title": "Participation (%)", "format": ".2f" }
          ]
        }
      }
    ]
  },
  "resolve": { "scale": { "y": "independent" } },
  "config": {
    "font": "Inter, system-ui, sans-serif",
    "view": { "stroke": null },
    "title": { "anchor": "start", "font": "Inter", "fontSize": 15, "fontWeight": 600, "color": "#14543b", "subtitleColor": "#5c6b63", "subtitlePadding": 6, "offset": 12 },
    "axis": { "labelFont": "Inter", "titleFont": "Inter", "labelColor": "#5c6b63", "titleColor": "#3a4a42", "grid": false }
  }
}
