{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Participation rate by state for the selected activity, 2025",
    "subtitle": "Share of adults who did the activity in 2025. Darker is higher. Shading rescales to each activity, so read the printed number for the exact value. Switch activity with the dropdown.",
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 500,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-132, 0],
    "parallels": [-18, -36]
  },
  "params": [
    {
      "name": "Activity",
      "value": "Bush walking",
      "bind": {
        "input": "select",
        "options": [
          "Bush walking",
          "Cycling",
          "Canoeing/Kayaking",
          "Mountain biking",
          "Rock climbing/Abseiling/Caving",
          "Sport climbing",
          "Surfing",
          "Fishing (recreational)",
          "Sailing"
        ],
        "name": "Activity:  "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/au_states.topojson",
        "format": { "type": "topojson", "feature": "STE11aAust" }
      },
      "transform": [{ "filter": "datum.properties.STATE_NAME !== 'Other Territories'" }],
      "mark": { "type": "geoshape", "fill": "#eef0ec", "stroke": "white", "strokeWidth": 1 }
    },
    {
      "data": { "url": "data/activity_by_state.csv" },
      "transform": [
        { "filter": "datum.activity == Activity" },
        {
          "lookup": "state_full",
          "from": {
            "data": {
              "url": "data/au_states.topojson",
              "format": { "type": "topojson", "feature": "STE11aAust" }
            },
            "key": "properties.STATE_NAME"
          },
          "as": "geo"
        }
      ],
      "mark": { "type": "geoshape", "stroke": "white", "strokeWidth": 1.2 },
      "encoding": {
        "shape": { "field": "geo", "type": "geojson" },
        "color": {
          "field": "rate",
          "type": "quantitative",
          "title": "Participation (% of adults, this activity)",
          "scale": {
            "type": "quantile",
            "scheme": "greens"
          },
          "legend": { "format": ".1f", "orient": "top", "direction": "horizontal", "titleFontSize": 11, "titleLimit": 240, "symbolSize": 150, "columns": 6, "offset": 8 }
        },
        "tooltip": [
          { "field": "state_full", "type": "nominal", "title": "State/Territory" },
          { "field": "activity", "type": "nominal", "title": "Activity" },
          { "field": "rate", "type": "quantitative", "title": "Participation (%)", "format": ".2f" }
        ]
      }
    },
    {
      "data": { "url": "data/activity_by_state.csv" },
      "transform": [
        { "filter": "datum.activity == Activity" },
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                { "state": "NSW", "lon": 147.0, "lat": -32.2 },
                { "state": "VIC", "lon": 144.2, "lat": -37.0 },
                { "state": "QLD", "lon": 144.0, "lat": -22.8 },
                { "state": "WA", "lon": 121.5, "lat": -25.8 },
                { "state": "SA", "lon": 135.3, "lat": -30.2 },
                { "state": "TAS", "lon": 150.6, "lat": -42.4 },
                { "state": "ACT", "lon": 151.6, "lat": -35.6 },
                { "state": "NT", "lon": 133.4, "lat": -19.6 }
              ]
            },
            "key": "state",
            "fields": ["lon", "lat"]
          }
        }
      ],
      "layer": [
        {
          "mark": { "type": "text", "fontSize": 11, "fontWeight": "bold", "stroke": "white", "strokeWidth": 3 },
          "encoding": {
            "longitude": { "field": "lon", "type": "quantitative" },
            "latitude": { "field": "lat", "type": "quantitative" },
            "text": { "field": "state", "type": "nominal" }
          }
        },
        {
          "mark": { "type": "text", "fontSize": 11, "fontWeight": "bold", "fill": "#14402e", "dy": 0 },
          "encoding": {
            "longitude": { "field": "lon", "type": "quantitative" },
            "latitude": { "field": "lat", "type": "quantitative" },
            "text": { "field": "state", "type": "nominal" }
          }
        },
        {
          "mark": { "type": "text", "fontSize": 10, "dy": 13, "stroke": "white", "strokeWidth": 3 },
          "encoding": {
            "longitude": { "field": "lon", "type": "quantitative" },
            "latitude": { "field": "lat", "type": "quantitative" },
            "text": { "field": "rate", "type": "quantitative", "format": ".1f" }
          }
        },
        {
          "mark": { "type": "text", "fontSize": 10, "dy": 13, "fill": "#2e2a22" },
          "encoding": {
            "longitude": { "field": "lon", "type": "quantitative" },
            "latitude": { "field": "lat", "type": "quantitative" },
            "text": { "field": "rate", "type": "quantitative", "format": ".1f" }
          }
        }
      ]
    }
  ],
  "config": {
    "font": "Inter, system-ui, sans-serif",
    "view": { "stroke": null },
    "title": { "anchor": "start", "font": "Inter", "fontSize": 15, "fontWeight": 600, "color": "#14543b", "subtitleColor": "#5c6b63", "subtitlePadding": 6, "offset": 10 },
    "legend": { "labelFont": "Inter", "titleFont": "Inter", "titleColor": "#3a4a42" }
  }
}
